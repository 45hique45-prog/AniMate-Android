<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">
    <ImageView
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Mika"
        android:src="@drawable/ic_mika_widget"
        android:scaleType="fitCenter" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AniMate"
            android:textColor="#DAB2FF"
            android:textStyle="bold"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/widget_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mika is waiting for you ♡"
            android:textColor="#F2EAFB"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap to visit Mika  ·  AniMate"
            android:textColor="#BBA9D0"
            android:textSize="10sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="9dp"
        android:text="OPEN"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="#8054B0" />
</LinearLayout>